# Copiază acest fișier ca .env și completează valorile. Toate sunt opționale.

# Portul pe care pornește serverul
PORT=3000

# Adresa publică a site-ului (folosită în emailuri, sitemap și linkuri), fără / la final
# SITE_URL=https://www.cofetaria-ta.ro

# Parola pentru /admin. Dacă lipsește, se generează una la prima pornire
# și se salvează în data/admin-password.txt
# ADMIN_PASSWORD=alege-o-parola-lunga

# Unde se păstrează baza de date și fotografiile încărcate
# DATA_DIR=./data

# Pune 1 dacă site-ul rulează în spatele unui proxy (nginx, Caddy, Render, Railway...)
# TRUST_PROXY=1

# Cookie-urile de administrare sunt trimise doar prin HTTPS când NODE_ENV=production.
# Pune false doar dacă rulezi în producție fără HTTPS (nerecomandat).
# SECURE_COOKIES=false

# Email (opțional) — pentru confirmările trimise clienților și notificarea comenzilor noi
# SMTP_HOST=smtp.exemplu.ro
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=comenzi@cofetaria-ta.ro
# SMTP_PASS=parola-smtp
# MAIL_FROM="Cofetăria Bezea <comenzi@cofetaria-ta.ro>"
# SHOP_NOTIFY_EMAIL=comenzi@cofetaria-ta.ro
